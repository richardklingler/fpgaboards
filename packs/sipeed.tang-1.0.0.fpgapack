{
  "files" : {
    "boards/sipeed.tang-primer-20k.fpgaboard" : "{\n  \"schema\": 1,\n  \"id\": \"sipeed.tang-primer-20k\",\n  \"name\": \"Tang Primer 20K\",\n  \"vendor\": \"Sipeed\",\n  \"revision\": \"Dock\",\n  \"target\": { \"family\": \"gowin\", \"device\": \"GW2A-LV18PG256C8/I7\" },\n  \"clocks\": [\n    { \"name\": \"clk\", \"pin\": \"H11\", \"frequencyMHz\": 27, \"ioStandard\": \"LVCMOS33\" }\n  ],\n  \"signals\": [\n    { \"name\": \"led[0]\", \"pin\": \"L16\", \"group\": \"LEDs\", \"label\": \"LED0\", \"activeLow\": true, \"ioStandard\": \"LVCMOS33\" },\n    { \"name\": \"led[1]\", \"pin\": \"L14\", \"group\": \"LEDs\", \"label\": \"LED1\", \"activeLow\": true, \"ioStandard\": \"LVCMOS33\" },\n    { \"name\": \"led[2]\", \"pin\": \"N14\", \"group\": \"LEDs\", \"label\": \"LED2\", \"activeLow\": true, \"ioStandard\": \"LVCMOS33\" },\n    { \"name\": \"led[3]\", \"pin\": \"N16\", \"group\": \"LEDs\", \"label\": \"LED3\", \"activeLow\": true, \"ioStandard\": \"LVCMOS33\" },\n    { \"name\": \"led[4]\", \"pin\": \"A13\", \"group\": \"LEDs\", \"label\": \"LED4\", \"activeLow\": true, \"ioStandard\": \"LVCMOS33\" },\n    { \"name\": \"led[5]\", \"pin\": \"C13\", \"group\": \"LEDs\", \"label\": \"LED5\", \"activeLow\": true, \"ioStandard\": \"LVCMOS33\" },\n\n    { \"name\": \"btn[0]\", \"pin\": \"T10\", \"group\": \"Buttons\", \"label\": \"S0\", \"activeLow\": true, \"ioStandard\": \"LVCMOS33\", \"pull\": \"up\" },\n\n    { \"name\": \"uart_tx\", \"pin\": \"M11\", \"group\": \"UART\", \"label\": \"FPGA_TX\", \"ioStandard\": \"LVCMOS33\", \"pull\": \"up\" },\n    { \"name\": \"uart_rx\", \"pin\": \"T13\", \"group\": \"UART\", \"label\": \"FPGA_RX\", \"ioStandard\": \"LVCMOS33\", \"pull\": \"up\" }\n  ],\n  \"programmer\": { \"tool\": \"openFPGALoader\", \"args\": [\"-b\", \"tangprimer20k\"], \"target\": \"sram\" },\n  \"usb\": [\n    { \"vid\": \"0x0403\", \"pid\": \"0x6010\" }\n  ],\n  \"documentation\": \"https://wiki.sipeed.com/hardware/en/tang/tang-primer-20k/primer-20k.html\",\n  \"sources\": [\n    \"https://raw.githubusercontent.com/litex-hub/litex-boards/master/litex_boards/platforms/sipeed_tang_primer_20k.py\",\n    \"https://raw.githubusercontent.com/YosysHQ/apicula/master/examples/primer20k.cst\",\n    \"https://raw.githubusercontent.com/trabucayre/openFPGALoader/master/doc/boards.yml\"\n  ],\n  \"note\": \"Core board on the Dock. Clock H11 (27 MHz), the six LEDs and button T10 agree between LiteX-boards (CARD1 connector mapping) and apicula's example. UART M11/T13 follows LiteX-boards and Sipeed's examples; apicula's example uses A15/D14 instead. Still to confirm on hardware: LED polarity (marked active low) and the debugger's USB product string (only the FT2232 IDs are listed, so detection asks which board it is). Checked 2026-10-04.\"\n}\n",
    "pack.json" : "{\n  \"schema\": 1,\n  \"id\": \"sipeed.tang\",\n  \"name\": \"Sipeed Tang\",\n  \"version\": \"1.0.0\",\n  \"type\": \"boards\",\n  \"maintainer\": \"FPGALab community\",\n  \"description\": \"Sipeed's Tang boards with Gowin FPGAs. Starts with the Tang Primer 20K on its dock.\",\n  \"documentation\": \"https://wiki.sipeed.com/hardware/en/tang/tang-primer-20k/primer-20k.html\"\n}\n"
  },
  "schema" : 1
}
